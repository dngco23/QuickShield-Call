{
  "name": "Recording",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "sos",
        "fake_call"
      ],
      "description": "Type of event that triggered the recording"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the uploaded audio file"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Duration of the recording in seconds"
    },
    "latitude": {
      "type": "number",
      "description": "GPS latitude at time of recording"
    },
    "longitude": {
      "type": "number",
      "description": "GPS longitude at time of recording"
    },
    "device_info": {
      "type": "string",
      "description": "User agent and device information"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this recording",
      "maxLength": 1000
    }
  },
  "required": [
    "event_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "read": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "update": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "delete": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    }
  }
}