{
  "name": "FamilyMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Family member's name"
    },
    "phone": {
      "type": "string",
      "description": "Family member's phone number"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "mother",
        "father",
        "sibling",
        "partner",
        "friend",
        "other"
      ],
      "description": "Relationship to user"
    },
    "is_emergency_contact": {
      "type": "boolean",
      "default": false,
      "description": "Whether this member should receive SOS alerts"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this family member",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "phone",
    "relationship"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "read": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "update": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "delete": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "isAuthenticated": true
      }
    }
  }
}