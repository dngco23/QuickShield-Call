{
  "name": "EmergencyContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name (e.g., Mom, Partner)"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "priority": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "tertiary"
      ],
      "default": "secondary",
      "description": "Contact priority level"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this contact",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}